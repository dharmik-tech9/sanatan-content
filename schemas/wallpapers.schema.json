{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sanatan wallpapers catalog",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id", "type", "categoryId", "titleGu", "titleHi", "titleEn",
      "thumbnailUrl", "previewUrl", "mediaUrl", "width", "height",
      "fileSizeBytes", "featured", "isActive", "sortOrder", "tags"
    ],
    "additionalProperties": false,
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
      "type": { "type": "string", "enum": ["STATIC", "LIVE"] },
      "deityId": { "type": ["string", "null"] },
      "categoryId": { "type": "string" },
      "titleGu": { "type": "string", "minLength": 1 },
      "titleHi": { "type": "string", "minLength": 1 },
      "titleEn": { "type": "string", "minLength": 1 },
      "thumbnailUrl": { "type": "string" },
      "previewUrl": { "type": "string" },
      "mediaUrl": { "type": "string", "minLength": 1 },
      "width": { "type": "integer", "minimum": 0 },
      "height": { "type": "integer", "minimum": 0 },
      "fileSizeBytes": { "type": "integer", "minimum": 1 },
      "featured": { "type": "boolean" },
      "isActive": { "type": "boolean" },
      "sortOrder": { "type": "integer", "minimum": 0 },
      "tags": { "type": "array", "items": { "type": "string" } }
    }
  }
}
