{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sanatan bhajans catalog",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id", "titleGu", "titleHi", "titleEn", "coverUrl", "audioUrl",
      "durationMs", "fileSizeBytes", "sha256", "lyrics", "featured", "isActive",
      "sortOrder", "tags"
    ],
    "additionalProperties": false,
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
      "deityId": { "type": ["string", "null"] },
      "titleGu": { "type": "string", "minLength": 1 },
      "titleHi": { "type": "string", "minLength": 1 },
      "titleEn": { "type": "string", "minLength": 1 },
      "coverUrl": { "type": "string" },
      "audioUrl": { "type": "string", "minLength": 1 },
      "durationMs": { "type": "integer", "minimum": 1 },
      "fileSizeBytes": { "type": "integer", "minimum": 1 },
      "sha256": { "type": "string", "pattern": "^([a-f0-9]{64})?$" },
      "lyrics": {
        "type": ["object", "null"],
        "additionalProperties": false,
        "properties": {
          "guUrl": { "type": ["string", "null"] },
          "hiUrl": { "type": ["string", "null"] },
          "enUrl": { "type": ["string", "null"] }
        }
      },
      "featured": { "type": "boolean" },
      "isActive": { "type": "boolean" },
      "sortOrder": { "type": "integer", "minimum": 0 },
      "tags": { "type": "array", "items": { "type": "string" } }
    }
  }
}
